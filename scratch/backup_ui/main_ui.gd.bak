var _selected_flag_data: Dictionary = {}
var _gui_controller = DynamicGuiControllerScript.new()

@onready var file_dialog: FileDialog = $FileDialog

var _bridge: Node = null
var _current_lang: String = "bg"
var _telemetry_timer: float = 0.0
var _active_file_dialog_target: String = ""

func _ready() -> void:
	_setup_bridge()
	_connect_signals()
	_apply_theme_and_accessibility()
	if _layout_manager != null:
		_layout_manager.init(self, main_split, bottom_deck, tab_container, btn_start_attack, btn_stop_attack, btn_view_setup, btn_view_cockpit)
	if _gui_controller != null:
		add_child(_gui_controller)
		_gui_controller.init_controller(work_split, console_help_split, console_panel, help_panel, btn_toggle_maximize, btn_collapse_help)
		_gui_controller.set_language(_current_lang)
	_populate_categories()
	_populate_workload_profiles()
	_populate_hash_algorithms()
	_setup_flags_guide()
	_apply_localization(_current_lang)
	_update_cli_preview()
	_update_hardware_telemetry()
	
	# Connect OS Window Drag & Drop for 1-click Raw File Ingestion
	if not get_tree().root.files_dropped.is_connected(_on_window_files_dropped):
		get_tree().root.files_dropped.connect(_on_window_files_dropped)

	# Connect window resize / resolution change signal for adaptive layout
	if not get_tree().root.size_changed.is_connected(_on_viewport_size_changed):
		get_tree().root.size_changed.connect(_on_viewport_size_changed)
	_on_viewport_size_changed()

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo:
		if event.keycode == KEY_F11:
			toggle_fullscreen()
			get_viewport().set_input_as_handled()

func toggle_fullscreen() -> void:
	var mode = DisplayServer.window_get_mode()
	if mode == DisplayServer.WINDOW_MODE_FULLSCREEN or mode == DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)
	else:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)
	_update_fullscreen_button_text()
	_on_viewport_size_changed()

func is_fullscreen() -> bool:
	var mode = DisplayServer.window_get_mode()
	return mode == DisplayServer.WINDOW_MODE_FULLSCREEN or mode == DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN

func _update_fullscreen_button_text() -> void:
	if btn_fullscreen == null:
		return
	if is_fullscreen():
		btn_fullscreen.text = _get_text("btn_windowed")
	else:
		btn_fullscreen.text = _get_text("btn_fullscreen")

func _on_viewport_size_changed() -> void:
	if not is_inside_tree():
		return
	var vp_size: Vector2 = get_viewport_rect().size
	if _gui_controller != null:
		_gui_controller.adapt_to_viewport_size(vp_size)
	_update_fullscreen_button_text()

func _process(delta: float) -> void:
	_telemetry_timer += delta
	if _telemetry_timer >= 1.0:
		_telemetry_timer = 0.0
		_update_hardware_telemetry()

func _update_hardware_telemetry() -> void:
	var telem: Dictionary = HardwareInspectorScript.get_system_telemetry()
	var cpu_pct: float = telem.get("cpu_usage_pct", 0.0)
	var ram_used: int = telem.get("ram_used_mb", 0)
	var ram_total: int = telem.get("ram_total_mb", 0)
	var gpu_name: String = telem.get("gpu_name", "GPU")
	var gpu_temp: int = telem.get("gpu_temp_c", 0)

	var status_str: String = "CPU: " + str(snapped(cpu_pct, 0.1)) + "% | RAM: " + str(ram_used) + "/" + str(ram_total) + "MB"
	if gpu_temp > 0:
		status_str += " | " + gpu_name + " (" + str(gpu_temp) + "°C)"

	label_telemetry.text = status_str
	if gpu_rack != null:
		gpu_rack.update_telemetry_sensors(telem)

func _setup_bridge() -> void:
	_bridge = HashcatBridgeScript.new()
	add_child(_bridge)
	_bridge.stdout_line_received.connect(_on_stdout_line)
	_bridge.stderr_line_received.connect(_on_stderr_line)
	_bridge.status_updated.connect(_on_status_updated)
	_bridge.hashrate_sample_received.connect(_on_hashrate_sample_received)
	_bridge.password_cracked.connect(_on_password_cracked)
	_bridge.process_finished.connect(_on_process_finished)
	_bridge.emergency_stopped.connect(_on_emergency_stopped)

func _apply_theme_and_accessibility() -> void:
	ThemeBuilderScript.apply_cyberpunk_theme(self)
	ThemeBuilderScript.style_action_buttons(btn_start_attack, btn_stop_attack, btn_emergency)
	
	# Modern styling for Run Example button
	if btn_run_example != null:
		var sb_run_ex: StyleBoxFlat = StyleBoxFlat.new()
		sb_run_ex.bg_color = Color("#064E3B") # Emerald 900
		sb_run_ex.set_border_width_all(1)
		sb_run_ex.border_color = Color("#10B981") # Emerald 500
		sb_run_ex.set_corner_radius_all(10)
		sb_run_ex.set_content_margin_all(8.0)
		btn_run_example.add_theme_stylebox_override("normal", sb_run_ex)

		var sb_run_ex_h: StyleBoxFlat = sb_run_ex.duplicate() as StyleBoxFlat
		sb_run_ex_h.bg_color = Color("#047857")
		sb_run_ex_h.border_color = Color.WHITE
		btn_run_example.add_theme_stylebox_override("hover", sb_run_ex_h)
		btn_run_example.add_theme_color_override("font_color", Color("#F8FAFC"))

func _connect_signals() -> void:
	# Fluid Layout Manager setup
	_layout_manager.init(self, main_split, bottom_deck, tab_container, btn_start_attack, btn_stop_attack, btn_view_setup, btn_view_cockpit)
	if btn_view_setup != null:
		btn_view_setup.pressed.connect(func():
			_layout_manager.pulse_button(btn_view_setup)
			_layout_manager.switch_to_setup(true)
		)
	if btn_view_cockpit != null:
		btn_view_cockpit.pressed.connect(func():
			_layout_manager.pulse_button(btn_view_cockpit)
			_layout_manager.switch_to_cockpit(true)
		)

	btn_emergency.pressed.connect(_on_btn_emergency_pressed)
	if btn_fullscreen != null:
		btn_fullscreen.pressed.connect(toggle_fullscreen)
	btn_start_attack.pressed.connect(_on_btn_start_pressed)
	btn_stop_attack.pressed.connect(_on_btn_stop_pressed)
	btn_run_benchmark.pressed.connect(_on_btn_benchmark_pressed)
	btn_lang.pressed.connect(_on_btn_lang_pressed)
	btn_detect.pressed.connect(_on_btn_detect_pressed)

	btn_browse_hash.pressed.connect(func(): _open_file_dialog("hash"))
	btn_browse_wordlist.pressed.connect(func(): _open_file_dialog("wordlist"))
	btn_quick_example.pressed.connect(_show_quick_example_info)
	file_dialog.file_selected.connect(_on_file_selected)

	btn_copy_example.pressed.connect(_copy_example_to_clipboard)
	btn_copy_command.pressed.connect(_copy_command_to_clipboard)
	btn_run_example.pressed.connect(_run_example_attack)

	btn_preset_md5.pressed.connect(func(): _apply_preset(0, 0, "", "-O"))
	btn_preset_ntlm.pressed.connect(func(): _apply_preset(0, 1000, "c $1 $!", "-O"))
	btn_preset_wpa2.pressed.connect(func(): _apply_preset(0, 22000, "", "-O"))
	btn_preset_bcrypt.pressed.connect(func(): _apply_preset(0, 3200, "", ""))

	opt_category.item_selected.connect(func(_idx): 
		_populate_hash_algorithms()
		_update_attack_intel_and_example()
	)
	opt_attack_mode.item_selected.connect(func(_idx): _on_attack_mode_changed())
	opt_hash_type.item_selected.connect(func(_idx): 
		_update_cli_preview()
		_update_attack_intel_and_example()
	)
	opt_workload.item_selected.connect(func(_idx): _update_cli_preview())

	edit_target_hash.text_changed.connect(func(_t): _update_cli_preview())
	edit_target_hash.text_submitted.connect(func(t): _ingest_path_automatically(t))
	edit_wordlist.text_changed.connect(func(_t): _update_cli_preview())
	edit_rules.text_changed.connect(func(_t): _update_cli_preview())
	edit_custom_flags.text_changed.connect(func(_t): _update_cli_preview())

	# Multi-Compute Rack signals
	gpu_rack.devices_selection_changed.connect(func(ids, flag):
		_update_cli_preview()
		if not ids.is_empty():
			var dev_note: String = "[🖥️ ИЗЧИСЛИТЕЛНА ТОПОЛОГИЯ] Активни устройства: %s (%s)" % [str(ids), flag] if _current_lang == "bg" else "[🖥️ COMPUTE TOPOLOGY] Active devices: %s (%s)" % [str(ids), flag]
			_append_to_console(dev_note, "#00E5FF")
	)

	# Header Layout View Switchers
	if btn_view_setup != null:
		btn_view_setup.pressed.connect(func():
			if _layout_manager != null:
				_layout_manager.pulse_button(btn_view_setup)
				_layout_manager.switch_to_setup(true)
		)
	if btn_view_cockpit != null:
		btn_view_cockpit.pressed.connect(func():
			if _layout_manager != null:
				_layout_manager.pulse_button(btn_view_cockpit)
				_layout_manager.switch_to_cockpit(true)
		)

	# Bottom Deck signals
	btn_clear_console.pressed.connect(_on_btn_clear_console_pressed)
	btn_toggle_maximize.pressed.connect(_on_btn_toggle_maximize_pressed)
	if btn_collapse_help != null:
		btn_collapse_help.pressed.connect(func():
			if _gui_controller != null:
				_gui_controller.toggle_help_panel()
		)

	# Flags Encyclopedia signals
	btn_open_flags_guide.pressed.connect(_on_btn_open_flags_guide_pressed)
	opt_flag_category.item_selected.connect(func(_idx): _filter_and_populate_flags())
	edit_flag_search.text_changed.connect(func(_text): _filter_and_populate_flags())
	tree_flags.item_selected.connect(_on_tree_flag_selected)
	btn_insert_flag.pressed.connect(_on_btn_insert_flag_pressed)
	btn_copy_flag.pressed.connect(_on_btn_copy_flag_pressed)

func _get_text(key: String) -> String:
	var lang_dict: Dictionary = LOCALES.get(_current_lang, LOCALES["en"])
	return lang_dict.get(key, key)

func _populate_categories() -> void:
	opt_category.clear()
	opt_category.add_item("All Categories", 0)
	opt_category.add_item("Hashes & Checksums", 1)
	opt_category.add_item("Windows & Active Directory", 2)
	opt_category.add_item("Linux / Unix", 3)
	opt_category.add_item("Wireless / Network", 4)
	opt_category.add_item("Archives & Encryption", 5)
	opt_category.add_item("Cryptocurrency Wallets", 6)
	opt_category.add_item("Web & Databases", 7)

func _populate_workload_profiles() -> void:
	opt_workload.clear()
	opt_workload.add_item("-w 1 | Low / Desktop", 1)
	opt_workload.add_item("-w 2 | Default / Balanced", 2)
	opt_workload.add_item("-w 3 | High / Performance", 3)
	opt_workload.add_item("-w 4 | Nightmare / Pure Raw Power", 4)
	opt_workload.select(2) # Default to High Performance -w 3

func _populate_hash_algorithms() -> void:
	var all_modes: Array[Dictionary] = HashDatabaseScript.get_all_modes()
	var selected_category_idx: int = opt_category.selected
	var category_filter: String = ""

	if selected_category_idx > 0:
		category_filter = opt_category.get_item_text(selected_category_idx)

	opt_hash_type.clear()
	for mode in all_modes:
		if category_filter.is_empty() or mode["cat"] == category_filter:
			var item_text: String = str(mode["id"]) + " | " + mode["name"] + " [" + mode["cat"] + "]"
			opt_hash_type.add_item(item_text, mode["id"])

	_update_attack_intel_and_example()

