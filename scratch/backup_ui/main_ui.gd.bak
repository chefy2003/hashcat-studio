func _setup_flags_guide() -> void:
	_populate_flag_categories()
	_filter_and_populate_flags()

func _populate_flag_categories() -> void:
	if opt_flag_category == null:
		return
	var selected_id: String = "all"
	if opt_flag_category.selected >= 0 and opt_flag_category.get_item_metadata(opt_flag_category.selected) != null:
		selected_id = str(opt_flag_category.get_item_metadata(opt_flag_category.selected))

	opt_flag_category.clear()
	var cats: Array[Dictionary] = FlagDatabaseScript.get_categories(_current_lang)
	var select_idx: int = 0
	for i in range(cats.size()):
		var c: Dictionary = cats[i]
		opt_flag_category.add_item(c["name"], i)
		opt_flag_category.set_item_metadata(i, c["id"])
		if c["id"] == selected_id:
			select_idx = i
	opt_flag_category.select(select_idx)

func _filter_and_populate_flags() -> void:
	if tree_flags == null:
		return
	tree_flags.clear()
	var root: TreeItem = tree_flags.create_item()

	var selected_cat_idx: int = opt_flag_category.selected
	var cat_id: String = "all"
	if selected_cat_idx >= 0 and opt_flag_category.get_item_metadata(selected_cat_idx) != null:
		cat_id = str(opt_flag_category.get_item_metadata(selected_cat_idx))

	var query: String = edit_flag_search.text.strip_edges()
	var flags: Array[Dictionary] = []
	if not query.is_empty():
		flags = FlagDatabaseScript.search_flags(query, _current_lang)
		if cat_id != "all":
			var filtered: Array[Dictionary] = []
			for f in flags:
				if f.get("cat_id", "") == cat_id:
					filtered.append(f)
			flags = filtered
	else:
		flags = FlagDatabaseScript.get_flags_by_category(cat_id, _current_lang)

	label_flag_count.text = ("%d опции" if _current_lang == "bg" else "%d flags") % flags.size()

	var cat_dict: Dictionary = {}
	for cat in FlagDatabaseScript.get_categories(_current_lang):
		cat_dict[cat["id"]] = cat["name"]

	var cat_groups: Dictionary = {}
	for f in flags:
		var c_id: String = f.get("cat_id", "misc")
		if not cat_groups.has(c_id):
			cat_groups[c_id] = []
		cat_groups[c_id].append(f)

	var first_item: TreeItem = null
	for c_id in cat_groups.keys():
		var cat_name: String = cat_dict.get(c_id, c_id)
		var cat_header: TreeItem = tree_flags.create_item(root)
		cat_header.set_text(0, "📁 " + cat_name)
		cat_header.set_selectable(0, false)
		cat_header.collapsed = false

		for f in cat_groups[c_id]:
			var item: TreeItem = tree_flags.create_item(cat_header)
			item.set_text(0, "• " + f.get("flag", "") + " | " + f.get("title", ""))
			item.set_metadata(0, f)
			if first_item == null:
				first_item = item

	if first_item != null:
		first_item.select(0)
		_display_flag_details(first_item.get_metadata(0))
	else:
		_selected_flag_data = {}
		text_flag_intel.clear()
		text_flag_intel.append_text("[color=#FFD700]Няма намерени опции по зададените критерии.[/color]" if _current_lang == "bg" else "[color=#FFD700]No flags found matching criteria.[/color]")

func _on_tree_flag_selected() -> void:
	var selected_item: TreeItem = tree_flags.get_selected()
	if selected_item != null and selected_item.get_metadata(0) != null:
		_display_flag_details(selected_item.get_metadata(0))

func _display_flag_details(f: Dictionary) -> void:
	_selected_flag_data = f
	if f.is_empty():
		text_flag_intel.clear()
		return

	var is_bg: bool = (_current_lang == "bg")
	var bbcode: String = ""
	bbcode += "[b][color=#00F0FF]" + ("⚡ ОПЦИЯ: " if is_bg else "⚡ FLAG: ") + "[/color][color=#00FF66]" + f.get("flag", "") + "[/color][/b]\n"
	bbcode += "[b][color=#FFD700]" + f.get("title", "") + "[/color][/b]  [color=#8B949E](" + ("Тип: " if is_bg else "Type: ") + f.get("type", "") + ")[/color]\n\n"
	bbcode += "[b][color=#00E5FF]" + ("🔍 КАКВО ПРАВИ И ЗАЩО СЕ ИЗПОЛЗВА: " if is_bg else "🔍 DESCRIPTION & USAGE: ") + "[/color][/b]\n"
	bbcode += "[color=#E6EDF3]" + f.get("desc", "") + "[/color]\n\n"
	bbcode += "[b][color=#00F0FF]" + ("💻 ГОТОВ ПРИМЕРЕН СИНТАКСИС: " if is_bg else "💻 PRACTICAL CLI EXAMPLE: ") + "[/color][/b]\n"
	bbcode += "[bgcolor=#0B0E14][color=#00FF66] " + f.get("example", "") + " [/color][/bgcolor]\n"

	text_flag_intel.clear()
	text_flag_intel.append_text(bbcode)

func _on_btn_clear_console_pressed() -> void:
	if text_console != null:
		text_console.clear()
	if text_cracked != null:
		text_cracked.clear()

func _on_btn_toggle_maximize_pressed() -> void:
	if _gui_controller != null:
		_gui_controller.toggle_console_maximize()

func _on_btn_insert_flag_pressed() -> void:
	if _selected_flag_data.is_empty():
		return
	var ex_val: String = _selected_flag_data.get("example", "")
	if ex_val.is_empty():
		ex_val = _selected_flag_data.get("flag", "").split(",")[0].strip_edges()

	var current_flags: String = edit_custom_flags.text.strip_edges()
	if ex_val in current_flags:
		var warn_msg: String = "[!] Флагът '%s' вече присъства в допълнителните параметри!" % ex_val if _current_lang == "bg" else "[!] Flag '%s' is already in additional parameters!" % ex_val
		_append_to_console(warn_msg, "#FFD700")
		return

	if current_flags.is_empty():
		edit_custom_flags.text = ex_val
	else:
		edit_custom_flags.text = current_flags + " " + ex_val

	_update_cli_preview()
	var add_msg: String = "[+] Добавен флаг към командата: " + ex_val if _current_lang == "bg" else "[+] Added flag to command string: " + ex_val
	_append_to_console(add_msg, "#00FF66")

func _on_btn_copy_flag_pressed() -> void:
	if _selected_flag_data.is_empty():
		return
	var ex_val: String = _selected_flag_data.get("example", "")
	if not ex_val.is_empty():
		DisplayServer.clipboard_set(ex_val)
		var msg: String = "[+] Копирано в клипборда: " + ex_val if _current_lang == "bg" else "[+] Copied to clipboard: " + ex_val
		_append_to_console(msg, "#00FF66")

func _on_btn_open_flags_guide_pressed() -> void:
	if _gui_controller != null:
		_gui_controller.ensure_help_panel_visible()
	if tab_container != null:
		tab_container.current_tab = 1
	if _gui_controller != null and not _gui_controller.is_console_maximized and work_split != null:
		if work_split.split_offset > -150:
			work_split.split_offset = -220

func _update_attack_intel_and_example() -> void:
	if opt_attack_mode.item_count == 0 or opt_hash_type.item_count == 0:
		return
	var attack_mode_id: int = opt_attack_mode.get_selected_id()
	var hash_mode_id: int = opt_hash_type.get_selected_id()

	var report: Dictionary = AttackDatabaseScript.build_full_intel_report(attack_mode_id, hash_mode_id, _current_lang)
	if text_intel != null:
		text_intel.text = report.get("summary_bbcode", "")
	_current_example_command = report.get("example_cli", "")

	_update_algorithm_example_display()

func _copy_command_to_clipboard() -> void:
	var cmd: String = _current_example_command
	if cmd.is_empty():
		cmd = edit_cli_preview.text.strip_edges()
	if not cmd.is_empty():
		DisplayServer.clipboard_set(cmd)
		var msg: String = "[+] CLI командата за тази конфигурация е копирана в клипборда: " + cmd if _current_lang == "bg" else "[+] CLI command for this configuration copied to clipboard: " + cmd
		_append_to_console(msg, "#00FF66")

func _update_algorithm_example_display() -> void:
	if opt_hash_type.item_count == 0:
		return
	var mode_id: int = opt_hash_type.get_selected_id()
	var info: Dictionary = HashDatabaseScript.get_example_info(mode_id)
	edit_example_hash.text = info.get("example_hash", "")
	label_ex_pass_val.text = info.get("example_pass", "hashcat")
	
	if info.get("is_deprecated", false):
		label_ex_mask_val.text = "[ОСТАРЯЛ! ИЗПОЛЗВАЙТЕ 22000]" if _current_lang == "bg" else "[DEPRECATED! USE 22000]"
		label_ex_mask_val.modulate = Color("#FF1744")
	else:
		var mask_val: String = info.get("benchmark_mask", "")
		label_ex_mask_val.text = mask_val if not mask_val.is_empty() else "N/A"
		label_ex_mask_val.modulate = Color("#FFFFFF")

func _load_example_into_target() -> void:
	if opt_hash_type.item_count == 0:
		return

	# Protect user's configured files from accidental overwriting
	if not edit_target_hash.text.strip_edges().is_empty() or not edit_wordlist.text.strip_edges().is_empty():
		var warn_msg: String = "[!] ВНИМАНИЕ: Полетата вече съдържат ваши файлове! Зареждането на пример е блокирано, за да не загубите пътищата си. Изчистете ги първо ръчно, ако желаете примерния хеш." if _current_lang == "bg" else "[!] PROTECTED: Input fields already contain your files! Loading example was blocked to prevent data loss. Clear inputs first if you want the sample."
		_append_to_console(warn_msg, "#FFD700")
		return

	var mode_id: int = opt_hash_type.get_selected_id()
	var info: Dictionary = HashDatabaseScript.get_example_info(mode_id)

	if info.get("is_deprecated", false):
		var repl_id: int = info.get("replacement_id", 22000)
		_append_to_console("[!] ВНИМАНИЕ: Режим %d е остарял. Автоматично превключване към Режим %d!" % [mode_id, repl_id], "#FFD700")
		_select_option_by_id(opt_hash_type, repl_id)
		mode_id = repl_id
		info = HashDatabaseScript.get_example_info(mode_id)

	var ex_hash: String = info.get("example_hash", "")
	var ex_pass: String = info.get("example_pass", "hashcat")
	var ex_mask: String = info.get("benchmark_mask", "")

	if ex_hash.is_empty():
		_append_to_console("[!] За избрания режим няма наличен официален пример.", "#FFD700")
		return

	edit_target_hash.text = ex_hash

	var mode_idx: int = opt_attack_mode.get_selected_id()
	if mode_idx == 3:
		if not ex_mask.is_empty():
			edit_wordlist.text = ex_mask
		else:
			edit_wordlist.text = "?a?a?a?a?a?a?a?a"
	elif mode_idx == 0:
		var sample_wordlist_path: String = "/tmp/studio_sample_wordlist.txt"
		var f: FileAccess = FileAccess.open(sample_wordlist_path, FileAccess.WRITE)
		if f != null:
			f.store_string("password\nadmin\n123456\n" + ex_pass + "\n")
			f.close()
			edit_wordlist.text = sample_wordlist_path

	_update_cli_preview()
	var msg: String = "[+] Зареден официален примерен хеш за режим " + str(mode_id) + " (" + info.get("name", "") + ")!" if _current_lang == "bg" else "[+] Loaded official example hash for mode " + str(mode_id) + " (" + info.get("name", "") + ")!"
	_append_to_console(msg, "#00FF66")

func _run_example_attack() -> void:
	if opt_hash_type.item_count == 0:
		return
	var mode_id: int = opt_hash_type.get_selected_id()
	var info: Dictionary = HashDatabaseScript.get_example_info(mode_id)

	# Auto-redirect deprecated mode
	if info.get("is_deprecated", false):
		var repl_id: int = info.get("replacement_id", 22000)
		_append_to_console("[!] ВНИМАНИЕ: Режим %d е остарял (deprecated). Автоматично превключване към модерен режим %d!" % [mode_id, repl_id], "#FFD700")
		_select_option_by_id(opt_hash_type, repl_id)
		mode_id = repl_id
		info = HashDatabaseScript.get_example_info(mode_id)

	var ex_hash: String = info.get("example_hash", "")
	var ex_pass: String = info.get("example_pass", "hashcat")
	var mode_name: String = info.get("name", "")

	if ex_hash.is_empty():
		_append_to_console("[!] За избрания режим няма наличен официален тестов хеш.", "#FF1744")
		return

	if gpu_rack != null:
		var active_devs: Array[int] = gpu_rack.get_active_device_ids()
		if active_devs.is_empty():
			var err_nodes: String = "[!] ВНИМАНИЕ: Всички изчислителни устройства са изолирани! Изберете '🖥️ САМО CPU' или конкретно устройство преди тест." if _current_lang == "bg" else "[!] WARNING: All compute devices are ISOLATED! Select CPU or a device before test."
			_append_to_console(err_nodes, "#FF1744")
			return

	# Write dedicated self-contained sandbox files - NEVER touch user's loaded input fields!
	var sample_hash_path: String = "/tmp/studio_sandbox_%d.hash" % mode_id
	var f_h: FileAccess = FileAccess.open(sample_hash_path, FileAccess.WRITE)
	if f_h != null:
		f_h.store_string(ex_hash + "\n")
		f_h.close()
	else:
		_append_to_console("[!] Не може да бъде създаден тестов файл в /tmp.", "#FF1744")
		return

	var sample_wordlist_path: String = "/tmp/studio_sandbox_%d.dict" % mode_id
	var f_w: FileAccess = FileAccess.open(sample_wordlist_path, FileAccess.WRITE)
	if f_w != null:
		f_w.store_string("alpha\nbeta\ngamma\nadmin\npassword\n123456\n" + ex_pass + "\n")
		f_w.close()
	else:
		_append_to_console("[!] Не може да бъде създаден тестов речник в /tmp.", "#FF1744")
		return

	var test_args: Array = ["-a", "0", "-m", str(mode_id), "-w", "3"]
	if gpu_rack != null:
		var dev_flag: String = gpu_rack.get_device_cli_flag()
		if not dev_flag.is_empty():
			for p in dev_flag.split(" "):
				test_args.append(p)
	test_args.append(sample_hash_path)
	test_args.append(sample_wordlist_path)

	_append_to_console("════════════════════════════════════════════════════════════════════", "#00F0FF")
	var run_msg: String = "[🚀 САМОСТОЯТЕЛЕН ТЕСТ] Стартиране на тест за Режим %d (%s)..." % [mode_id, mode_name] if _current_lang == "bg" else "[🚀 SANDBOX TEST] Executing official test vector for Mode %d (%s)..." % [mode_id, mode_name]
	_append_to_console(run_msg, "#00FF66")
	var safe_msg: String = "[🔒 ЗАЩИТА НА ДАННИТЕ] Вашите заредени работни файлове са запазени непокътнати!" if _current_lang == "bg" else "[🔒 DATA INTEGRITY] Your loaded target files remain untouched and safe!"
	_append_to_console(safe_msg, "#00F0FF")
	_append_to_console("[📋 ТЕСТОВИ ХЕШ] " + ex_hash, "#8B949E")
	_append_to_console("[🔑 ОЧАКВАНА ПАРОЛА] '" + ex_pass + "'", "#FFD700")
	_append_to_console("════════════════════════════════════════════════════════════════════", "#00F0FF")

	label_status.text = _get_text("status_running")
	label_status.modulate = Color("#00F0FF")
	performance_graph.reset_graph()
	btn_start_attack.disabled = true
	btn_stop_attack.disabled = false

	_bridge.start_attack(test_args)

func _copy_example_to_clipboard() -> void:
	var ex_hash: String = edit_example_hash.text.strip_edges()
	if not ex_hash.is_empty():
		DisplayServer.clipboard_set(ex_hash)
		var msg: String = "[+] Примерният хеш е копиран в клипборда!" if _current_lang == "bg" else "[+] Example hash copied to clipboard!"
		_append_to_console(msg, "#00FF66")

func _show_quick_example_info() -> void:
	if opt_hash_type.item_count == 0:
		return
	var mode_id: int = opt_hash_type.get_selected_id()
	var info: Dictionary = HashDatabaseScript.get_example_info(mode_id)
	var ex_hash: String = info.get("example_hash", "")
	var ex_pass: String = info.get("example_pass", "hashcat")
	if not ex_hash.is_empty():
		DisplayServer.clipboard_set(ex_hash)
		var msg: String = "[💡 ПРИМЕРЕН ХЕШ ЗА РЕЖИМ %d] %s | Парола: '%s' (Копиран в клипборда. Работните ви файлове са запазени!)" % [mode_id, ex_hash, ex_pass] if _current_lang == "bg" else "[💡 EXAMPLE HASH FOR MODE %d] %s | Pass: '%s' (Copied to clipboard. Your files are preserved!)" % [mode_id, ex_hash, ex_pass]
		_append_to_console(msg, "#00F0FF")

func _populate_attack_modes() -> void:
	var selected_mode_id: int = 0
	if opt_attack_mode.item_count > 0:
		selected_mode_id = opt_attack_mode.get_selected_id()

	opt_attack_mode.clear()
	opt_attack_mode.add_item(_get_text("mode_0"), 0)
	opt_attack_mode.add_item(_get_text("mode_1"), 1)
	opt_attack_mode.add_item(_get_text("mode_3"), 3)
	opt_attack_mode.add_item(_get_text("mode_6"), 6)
	opt_attack_mode.add_item(_get_text("mode_7"), 7)
	_select_option_by_id(opt_attack_mode, selected_mode_id)

func _apply_preset(mode_id: int, hash_type_id: int, rules: String, flags: String) -> void:
	opt_category.select(0)
	_populate_hash_algorithms()

	_select_option_by_id(opt_attack_mode, mode_id)
	_select_option_by_id(opt_hash_type, hash_type_id)
	edit_rules.text = rules
	edit_custom_flags.text = flags
	_on_attack_mode_changed()
	_update_cli_preview()
	_update_attack_intel_and_example()

func _select_option_by_id(option_btn: OptionButton, item_id: int) -> void:
	for i in range(option_btn.item_count):
		if option_btn.get_item_id(i) == item_id:
			option_btn.select(i)
			return

func _on_attack_mode_changed() -> void:
	var mode_id: int = opt_attack_mode.get_selected_id()
	if mode_id == 3:
		label_wordlist_file.text = "Маска / Модел за атака (напр. ?d?d?d?d?d?d?d?d)" if _current_lang == "bg" else "Mask / Charset Pattern (e.g. ?d?d?d?d?d?d?d?d)"
		edit_wordlist.placeholder_text = "?d?d?d?d?d?d?d?d or ?a?a?a?a?a?a"
	else:
		label_wordlist_file.text = _get_text("label_wordlist_file")
		edit_wordlist.placeholder_text = "Path to wordlist dictionary (e.g. /path/to/wordlist.txt)"
	_update_cli_preview()
	_update_attack_intel_and_example()

func _update_cli_preview() -> void:
	var args: PackedStringArray = _build_hashcat_args()
	edit_cli_preview.text = "hashcat " + " ".join(args)

func _build_hashcat_args() -> PackedStringArray:
	var args: PackedStringArray = []

	var attack_mode_id: int = opt_attack_mode.get_selected_id()
	args.append("-a")
	args.append(str(attack_mode_id))

	args.append("-m")
	args.append(str(opt_hash_type.get_selected_id()))

	# Include GPU rack device selection (-d 1,2,3,4)
	if gpu_rack != null:
		var dev_flag: String = gpu_rack.get_device_cli_flag()
		if not dev_flag.is_empty():
			var dev_parts: PackedStringArray = dev_flag.split(" ")
			for p in dev_parts:
				args.append(p)

	var workload_id: int = opt_workload.get_selected_id()
	if workload_id > 0:
		args.append("-w")
		args.append(str(workload_id))

	var rules: String = edit_rules.text.strip_edges()
	if not rules.is_empty():
		args.append("-j")
		args.append("'" + rules + "'")

	var custom_flags: String = edit_custom_flags.text.strip_edges()
	if not custom_flags.is_empty():
		for flag in custom_flags.split(" "):
			if not flag.is_empty():
				args.append(flag)

	var hash_input: String = edit_target_hash.text.strip_edges()
	if not hash_input.is_empty():
		args.append(hash_input)

	var wordlist_input: String = edit_wordlist.text.strip_edges()
	if not wordlist_input.is_empty():
		args.append(wordlist_input)
	elif attack_mode_id == 3:
		args.append("?d?d?d?d?d?d?d?d")

	return args

func _on_btn_detect_pressed() -> void:
	var raw_hash: String = edit_raw_hash.text.strip_edges()
	text_detector_results.clear()

	if raw_hash.is_empty():
		text_detector_results.append_text("[color=#FF1744]Please paste a raw hash string above for diagnosis.[/color]\n")
		return

	var matches: Array[Dictionary] = HashDatabaseScript.auto_detect_hash(raw_hash)
	if matches.is_empty():
		text_detector_results.append_text("[color=#FFD700][!] Unknown format. Please verify characters/salt.[/color]\n")
		return

	var top_match: Dictionary = matches[0]
	var line: String = "[color=#00FF66]• Detected: Mode " + str(top_match["id"]) + " | " + top_match["name"] + " (" + top_match["confidence"] + ")[/color]"
	text_detector_results.append_text(line)

	opt_category.select(0)
	_populate_hash_algorithms()
	_select_option_by_id(opt_hash_type, top_match["id"])
	_update_cli_preview()

func _on_btn_benchmark_pressed() -> void:
	var selected_hash_mode: int = opt_hash_type.get_selected_id()
	var workload_id: int = opt_workload.get_selected_id()
	if workload_id <= 0:
		workload_id = 3

	if gpu_rack != null:
		var active_devs: Array[int] = gpu_rack.get_active_device_ids()
		if active_devs.is_empty():
			var err_nodes: String = "[!] ВНИМАНИЕ: Всички изчислителни устройства са изолирани! Изберете '🖥️ САМО CPU' или конкретно устройство преди бенчмарк." if _current_lang == "bg" else "[!] WARNING: All compute devices are ISOLATED! Select CPU or a device before benchmark."
			_append_to_console(err_nodes, "#FF1744")
			return

	label_status.text = _get_text("status_running")
	label_status.modulate = Color("#00F0FF")
	var target_flag_str: String = gpu_rack.get_device_cli_flag() if gpu_rack != null else ""
	var dev_info: String = " (%s)" % target_flag_str if not target_flag_str.is_empty() else ""
	text_console.append_text("[color=#00F0FF][+] БЕЗОПАСЕН БЕНЧМАРК (-b) ЗА РЕЖИМ " + str(selected_hash_mode) + dev_info + "...[/color]\n")

	performance_graph.reset_graph()
	btn_start_attack.disabled = true
	btn_stop_attack.disabled = false

	if _layout_manager != null:
		_layout_manager.pulse_button(btn_run_benchmark)
		_layout_manager.switch_to_cockpit(true)

	var benchmark_args: Array = ["-b", "-m", str(selected_hash_mode), "-w", str(workload_id)]

	# Add active device selection to benchmark as well (-d <active_ids>)
	if gpu_rack != null:
		var dev_flag: String = gpu_rack.get_device_cli_flag()
		if not dev_flag.is_empty():
			var dev_parts: PackedStringArray = dev_flag.split(" ")
			for p in dev_parts:
				benchmark_args.append(p)

	_bridge.start_attack(benchmark_args)

func _open_file_dialog(target_type: String) -> void:
	_active_file_dialog_target = target_type
	file_dialog.file_mode = FileDialog.FILE_MODE_OPEN_FILE
	file_dialog.access = FileDialog.ACCESS_FILESYSTEM
	file_dialog.filters.clear()
	if target_type == "hash":
		file_dialog.title = "Избери файл с хешове / Handshake" if _current_lang == "bg" else "Select Target Hashes / Handshake File"
		file_dialog.add_filter("*.hc22000, *.22000, *.cap, *.pcap, *.pcapng, *.hccapx, *.hash, *.txt", "Hash / Handshake Files")
		file_dialog.add_filter("*.*", "All Files")
	elif target_type == "wordlist":
		file_dialog.title = "Избери речник (Wordlist)" if _current_lang == "bg" else "Select Wordlist / Dictionary"
		file_dialog.add_filter("*.txt, *.dict, *.words, *.lst", "Wordlist Files")
		file_dialog.add_filter("*.*", "All Files")
	file_dialog.popup_centered(Vector2i(750, 500))

func _on_window_files_dropped(files: PackedStringArray) -> void:
	if files.is_empty():
		return
	for f in files:
		_ingest_path_automatically(f)

func _on_file_selected(path: String) -> void:
	if _active_file_dialog_target == "hash":
		_ingest_path_automatically(path)
	elif _active_file_dialog_target == "wordlist":
		edit_wordlist.text = path
		_update_cli_preview()
	_active_file_dialog_target = ""

func _ingest_path_automatically(file_path: String) -> void:
	file_path = file_path.strip_edges()
	if file_path.is_empty():
		return

	# Handle wordlists automatically if dropped
	var lower_path: String = file_path.to_lower()
	if lower_path.ends_with(".dict") or lower_path.ends_with(".words") or lower_path.ends_with(".lst") or ("rockyou" in lower_path and not lower_path.ends_with(".hash")):
		edit_wordlist.text = file_path
		var msg_wl: String = "[📚 АВТО-ЗАРЕЖДАНЕ НА РЕЧНИК] " + file_path if _current_lang == "bg" else "[📚 AUTO-LOADED WORDLIST] " + file_path
		_append_to_console(msg_wl, "#00E5FF")
		_update_cli_preview()
		return

	_append_to_console("[⚡ SMART AUTO-INGESTION] Анализиране на файл: " + file_path + "...", "#00F0FF")

	var result: Dictionary = RawIngestEngineScript.ingest_file(file_path, _current_lang)
	if not result.get("success", false):
		var err_msg: String = "[!] Грешка при обработка: " + result.get("error", "Неизвестна грешка") if _current_lang == "bg" else "[!] Ingestion error: " + result.get("error", "Unknown error")
		_append_to_console(err_msg, "#FF1744")
		edit_target_hash.text = file_path
		return

	# 1. Automatic Handover of Converted Target Hash Path
	var target_hash_path: String = result.get("target_hash_path", file_path)
	edit_target_hash.text = target_hash_path

	# 2. Automatic Handover of Hash Mode (-m)
	var mode_id: int = result.get("hash_mode", 0)
	opt_category.select(0)
	_populate_hash_algorithms()
	_select_option_by_id(opt_hash_type, mode_id)

	# 3. Automatic Handover of Recommended Optimized Flags
	var rec_flags: String = result.get("recommended_flags", "")
	if not rec_flags.is_empty():
		var cur_flags: String = edit_custom_flags.text.strip_edges()
		if not rec_flags in cur_flags:
			if cur_flags.is_empty():
				edit_custom_flags.text = rec_flags
			else:
				edit_custom_flags.text = cur_flags + " " + rec_flags

	# 4. Auto-populate rockyou.txt if wordlist field is currently empty
	if edit_wordlist.text.strip_edges().is_empty():
		if FileAccess.file_exists("/home/deliriumxs/wordlists/rockyou.txt"):
			edit_wordlist.text = "/home/deliriumxs/wordlists/rockyou.txt"
		elif FileAccess.file_exists("/usr/share/wordlists/rockyou.txt"):
			edit_wordlist.text = "/usr/share/wordlists/rockyou.txt"

	# 5. Refresh UI Intel & CLI Command in Real-Time
	_update_attack_intel_and_example()
	_update_cli_preview()

	# 6. High-Visibility Terminal Summary
	var summary: String = result.get("summary_message", "")
	if not summary.is_empty():
		_append_to_console(summary, "#00FF66")

	var ready_msg: String = "==================================================\n" + \
		("👉 ГОТОВО ЗА 1 КЛИК! Всичко е конфигурирано автоматично.\nОстава само 1 бутон: [▶ СТАРТИРАЙ АТАКА]" if _current_lang == "bg" else "👉 READY IN 1-CLICK! Everything auto-configured.\nOnly 1 button remaining: [▶ EXECUTE ATTACK ENGINE]") + \
		"\n=================================================="
	_append_to_console(ready_msg, "#00F0FF")

func _on_btn_start_pressed() -> void:
	if gpu_rack != null:
		var active_devs: Array[int] = gpu_rack.get_active_device_ids()
		if active_devs.is_empty():
			var err_nodes: String = "[!] ВНИМАНИЕ: Всички изчислителни устройства са изолирани! Изберете '🖥️ САМО CPU' или конкретно устройство в Compute Topology преди стартиране." if _current_lang == "bg" else "[!] WARNING: All compute devices are ISOLATED! Please select 'CPU' or an active device before execution."
			_append_to_console(err_nodes, "#FF1744")
			return

	# Deprecated mode 2500 safety check
	var current_mode_id: int = opt_hash_type.get_selected_id()
	if current_mode_id == 2500:
		_append_to_console("[!] ВНИМАНИЕ: Режим 2500 (WPA EAPOL) е премахнат/остарял в Hashcat v7+! Автоматично превключване към Режим 22000 (WPA-PBKDF2-PMKID/EAPOL).", "#FFD700")
		_select_option_by_id(opt_hash_type, 22000)
		_update_cli_preview()

	var hash_input: String = edit_target_hash.text.strip_edges()
	if hash_input.is_empty():
		var err_msg: String = "[!] Грешка: Моля въведете файл с хешове или WPA2 handshake (.hc22000 / .hash)!" if _current_lang == "bg" else "[!] Error: Please specify a target hash or WPA2 handshake file (.hc22000 / .hash)!"
		_append_to_console(err_msg, "#FF1744")
		return

	# If user typed or pasted an unconverted raw file directly, auto-ingest it right now!
	var ext: String = hash_input.get_extension().to_lower()
	if ext in ["cap", "pcap", "pcapng", "7z", "pdf", "zip"] or hash_input.get_file().begins_with("UTC--") or ext == "json":
		_ingest_path_automatically(hash_input)
		hash_input = edit_target_hash.text.strip_edges()

	# Prevent feeding compressed archives (.gz/.zip) directly to Hashcat
	if hash_input.ends_with(".gz") or hash_input.ends_with(".zip") or hash_input.ends_with(".tar"):
		var err_gz: String = "[!] Грешка: Файлът с цели '%s' е компресиран архив! Hashcat изисква чист текстов файл (.hash / .hc22000)." % hash_input if _current_lang == "bg" else "[!] Error: Target file '%s' is compressed! Hashcat requires a raw text file." % hash_input
		_append_to_console(err_gz, "#FF1744")
		return

	# Prevent accidentally putting rockyou or wordlist into the target hash field
	if "rockyou" in hash_input.to_lower() or "wordlist" in hash_input.to_lower():
		var err_wl_as_hash: String = "[!] Грешка: Избрали сте речник (%s) като целеви хеш! Моля изберете го в полето 'Основен речник' и въведете валиден хеш/handshake." % hash_input if _current_lang == "bg" else "[!] Error: Selected file (%s) is a wordlist, not a hash file! Place it in 'Primary Wordlist'." % hash_input
		_append_to_console(err_wl_as_hash, "#FF1744")
		return

	var attack_mode_id: int = opt_attack_mode.get_selected_id()
	var wordlist_input: String = edit_wordlist.text.strip_edges()

	# If wordlist is rockyou.txt.gz, auto-swap with extracted version if available
	if wordlist_input.ends_with("rockyou.txt.gz"):
		if FileAccess.file_exists("/home/deliriumxs/wordlists/rockyou.txt"):
			wordlist_input = "/home/deliriumxs/wordlists/rockyou.txt"
			edit_wordlist.text = wordlist_input
			_append_to_console("[+] Auto-swapped rockyou.txt.gz with uncompressed /home/deliriumxs/wordlists/rockyou.txt", "#00F0FF")
		else:
			var err_wlgz: String = "[!] Грешка: Речникът е компресиран (.gz)! Моля разархивирайте го (gunzip) преди атака." if _current_lang == "bg" else "[!] Error: Wordlist is compressed (.gz)! Please uncompress it (gunzip) before attacking."
			_append_to_console(err_wlgz, "#FF1744")
			return

	if attack_mode_id == 0 and wordlist_input.is_empty():
		# If user didn't enter a wordlist, default to the extracted rockyou.txt if available
		if FileAccess.file_exists("/home/deliriumxs/wordlists/rockyou.txt"):
			wordlist_input = "/home/deliriumxs/wordlists/rockyou.txt"
			edit_wordlist.text = wordlist_input
			_append_to_console("[+] Using standard dictionary: /home/deliriumxs/wordlists/rockyou.txt", "#00F0FF")
		else:
			var err_wl: String = "[!] Грешка: За атака с речник (-a 0) е необходим файл с думи (Wordlist)!" if _current_lang == "bg" else "[!] Error: Dictionary attack (-a 0) requires a wordlist file path!"
			_append_to_console(err_wl, "#FF1744")
			return

	if hash_input == wordlist_input:
		var err_same: String = "[!] Грешка: Целевият хеш и речникът не могат да бъдат един и същ файл!" if _current_lang == "bg" else "[!] Error: Target hash and wordlist cannot be the exact same file!"
		_append_to_console(err_same, "#FF1744")
		return

	# Handle direct raw hash vs file path
	var target_path: String = hash_input
	if not FileAccess.file_exists(hash_input):
		var temp_path: String = "/tmp/studio_target_%d.hash" % OS.get_process_id()
		var f: FileAccess = FileAccess.open(temp_path, FileAccess.WRITE)
		if f != null:
			f.store_string(hash_input + "\n")
			f.close()
			target_path = temp_path
			_append_to_console("[INFO] Raw hash written to session file: " + temp_path, "#00F0FF")
		else:
			var err_file: String = "[!] Не може да бъде създаден временен файл за хеша." if _current_lang == "bg" else "[!] Could not create temporary file for raw hash."
			_append_to_console(err_file, "#FF1744")
			return

	var args: PackedStringArray = _build_hashcat_args()
	for i in range(args.size()):
		if args[i] == hash_input:
			args[i] = target_path
		elif args[i] == edit_wordlist.text.strip_edges() and not wordlist_input.is_empty():
			args[i] = wordlist_input

	var arr_args: Array = []
	for arg in args:
		arr_args.append(arg)

	label_status.text = _get_text("status_running")
	label_status.modulate = Color("#00F0FF")
	_append_to_console("[+] EXECUTING ATTACK PROCESS...", "#00F0FF")

	performance_graph.reset_graph()
	btn_start_attack.disabled = true
	btn_stop_attack.disabled = false

	if _layout_manager != null:
		_layout_manager.pulse_button(btn_start_attack)
		_layout_manager.switch_to_cockpit(true)

	_bridge.start_attack(arr_args)

func _append_to_console(line: String, color_hex: String = "") -> void:
	if text_console.get_line_count() > 800:
		var current_text: String = text_console.text
		var half_idx: int = current_text.find("\n", current_text.length() / 2)
		if half_idx != -1:
			text_console.text = current_text.substr(half_idx + 1)

	if color_hex.is_empty():
		if line.begins_with("[KERNEL]"):
			color_hex = "#00F0FF"
		elif line.begins_with("[ТЕЛЕМЕТРИЯ]") or line.begins_with("[TELEMETRY]"):
			color_hex = "#00E5FF"
		elif line.begins_with("[STATUS") or line.begins_with("[+]"):
			color_hex = "#00FF66"
		elif line.begins_with("[CRACKED]") or "🎉" in line:
			color_hex = "#FFEA00"
		elif line.begins_with("[!]") or line.begins_with("[ERROR]"):
			color_hex = "#FF1744"
		elif line.begins_with("[🚀"):
			color_hex = "#00F0FF"
		elif line.begins_with("[SYSTEM]"):
			color_hex = "#80CBC4"

	if color_hex.is_empty():
		text_console.append_text(line + "\n")
	else:
		text_console.append_text("[color=" + color_hex + "]" + line + "[/color]\n")
	text_console.scroll_to_line(text_console.get_line_count() - 1)

func _on_btn_stop_pressed() -> void:
	if _layout_manager != null:
		_layout_manager.pulse_button(btn_stop_attack)
	_bridge.stop_attack_emergency()

func _on_btn_emergency_pressed() -> void:
	_bridge.stop_attack_emergency()

func _on_btn_lang_pressed() -> void:
	if _current_lang == "en":
		_apply_localization("bg")
	else:
		_apply_localization("en")

func _on_stdout_line(line: String) -> void:
	_append_to_console(line)

func _on_stderr_line(line: String) -> void:
	_append_to_console(line, "#FF1744")

func _on_status_updated(data: Dictionary) -> void:
	var rate: String = str(data.get("hashrate", "0 H/s"))
	var prog: String = str(data.get("progress", "0%"))
	label_status.text = ("СКОРОСТ: " + rate + " | ПРОГРЕС: " + prog) if _current_lang == "bg" else ("SPEED: " + rate + " | PROG: " + prog)
	label_status.modulate = Color("#00FF66")

func _on_hashrate_sample_received(speed_val: float, _unit: String, raw_str: String) -> void:
	performance_graph.push_sample(speed_val, raw_str)

func _on_password_cracked(hash_val: String, plain_val: String) -> void:
	if text_cracked.get_line_count() > 500:
		text_cracked.clear()
	text_cracked.append_text("[color=#00FF66][CRACKED MATCH][/color] " + hash_val + " : [b]" + plain_val + "[/b]\n")
	text_cracked.scroll_to_line(text_cracked.get_line_count() - 1)
	_append_to_console(">>> CRACKED: " + hash_val + " = " + plain_val + " <<<", "#00FF66")

func _on_process_finished(exit_code: int) -> void:
	label_status.text = _get_text("status_ready") + " (" + str(exit_code) + ")"
	label_status.modulate = Color("#00FF66")
	btn_start_attack.disabled = false
	btn_stop_attack.disabled = true

func _on_emergency_stopped() -> void:
	label_status.text = _get_text("status_stopped")
	label_status.modulate = Color("#FF1744")
	text_console.append_text("[color=#FF1744][!] EMERGENCY STOP CIRCUIT BREAKER ACTIVATED.[/color]\n")
	btn_start_attack.disabled = false
	btn_stop_attack.disabled = true
