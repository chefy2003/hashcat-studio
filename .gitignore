# Unreal Engine Gitignore for Hashcat Studio Pro

# Engine temporary & built directories
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Core dumps and logs
*.log
gpucore.*
core.*

# User-specific settings & workspaces
.idea/
.vscode/
*.VC.db
*.opendb
*.sln
*.suo
*.user
*.workspace

# OS files
.DS_Store
Thumbs.db
__pycache__/
*.pyc
